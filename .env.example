# Anthropic API key (required for live analysis and AI report)
ANTHROPIC_API_KEY=sk-ant-...
# Claude model used for live call analysis and the report (default below)
SENTICALL_MODEL=claude-opus-5-5
# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# cuda | cpu | auto
WHISPER_DEVICE=auto
# Server port
SENTICALL_PORT=8050
